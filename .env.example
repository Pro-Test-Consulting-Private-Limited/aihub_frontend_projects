# App auth (Microsoft Entra) — required for local Sign in with Microsoft
NEXT_PUBLIC_MICROSOFT_ENTRA_CLIENT_ID=
NEXT_PUBLIC_MICROSOFT_ENTRA_TENANT_ID=
NEXT_PUBLIC_MICROSOFT_ENTRA_AD_REDIRECT_URI=http://localhost:3000/

# Jira OAuth 2.0 (3LO)
# Create an app at https://developer.atlassian.com/console/myapps/
# Callback URL must match JIRA_REDIRECT_URI exactly.
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
JIRA_REDIRECT_URI=http://localhost:3000/api/auth/jira/callback
JIRA_SCOPES=read:jira-work write:jira-work read:jira-user offline_access

# GitHub OAuth App
# Create an app at https://github.com/settings/developers
# Authorization callback URL must match GITHUB_REDIRECT_URI exactly.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3000/api/auth/github/callback
GITHUB_SCOPES=repo read:user user:email
